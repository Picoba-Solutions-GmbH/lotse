POSTGRES_HOST=localhost
POSTGRES_USER=root
POSTGRES_PASSWORD=lotse
POSTGRES_DB=lotse

ACTIVEMQ_HOST=localhost
ACTIVEMQ_PORT=61616
ACTIVEMQ_USER=artemis
ACTIVEMQ_PASSWORD=artemis
ACTIVEMQ_QUEUE_NAME=package_execution_queue

APP_NAME="Lotse"
API_VERSION="24.12.1"
OPENAPI_PREFIX_PATH=""

PYTHONUNBUFFERED=1
K8S_NAMESPACE="lotse"

ENABLE_AUTH="false"

# Git sync: deploy package versions from Git tags
GIT_SYNC_ENABLED="true"
# GIT_SSL_CAINFO=/path/to/internal-ca.pem
# file:// repositories, only for local testing
# GIT_ALLOW_FILE_URLS="true"
# Container registries: CA bundle for internal registries, hosts reached via plain http
# REGISTRY_CA_BUNDLE=/path/to/internal-ca.pem
# REGISTRY_INSECURE_HOSTS=registry.local:5000
